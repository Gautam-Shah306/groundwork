# Supported providers: gemini, groq
LLM_PROVIDER=gemini

# Provider API key (secret - never commit or expose)
LLM_API_KEY=

# Model name: set explicitly for your provider (no default)
# Examples:
#   Gemini: gemini-2.5-flash
#   Groq:   openai/gpt-oss-20b or llama-3.3-70b-versatile
LLM_MODEL=

# Client request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# Max retries on transient errors (rate limits and 5xx)
LLM_MAX_RETRIES=2

# Maximum generation output tokens (default 2500 for assistant, 4000 for discovery)
# Reasoning models (e.g. openai/gpt-oss) consume reasoning tokens against this budget
LLM_MAX_OUTPUT_TOKENS=2500
LLM_DISCOVERY_MAX_OUTPUT_TOKENS=4000

# Reasoning effort for reasoning models (default: low)
LLM_REASONING_EFFORT=low

DATABASE_URL=sqlite:///./data/groundwork.db
CORS_ORIGINS=http://localhost:5173
SEED_ON_START=false
